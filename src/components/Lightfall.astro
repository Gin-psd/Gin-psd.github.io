---
import type { LightfallOptions } from '../scripts/lightfall';

interface Props extends LightfallOptions {
  /** 附加类名 */
  className?: string;
  /** 附加内联样式 */
  style?: string;
}

const {
  colors = ['#ffffff'],
  backgroundColor = '#94a3b8',
  speed = 0.3,
  streakCount = 2,
  streakWidth = 0.8,
  streakLength = 1,
  glow = 1,
  density = 0.6,
  twinkle = 0.3,
  zoom = 3,
  backgroundGlow = 0.1,
  headGlow = 0.6,
  depth = 0.5,
  bloom = 0.35,
  opacity = 1,
  mouseInteraction = true,
  mouseStrength = 0.4,
  mouseRadius = 0.45,
  mouseDampening = 0.15,
  lens = 0.5,
  holdToWarp = true,
  intro = true,
  fade = 0,
  lightMode = false,
  mixBlendMode,
  paused = false,
  dpr,
  dark,
  light,
  className = '',
  style,
} = Astro.props;

/** 序列化配置，由客户端脚本读取（undefined 字段会被 JSON.stringify 自动省略） */
const config = {
  colors,
  backgroundColor,
  speed,
  streakCount,
  streakWidth,
  streakLength,
  glow,
  density,
  twinkle,
  zoom,
  backgroundGlow,
  headGlow,
  depth,
  bloom,
  opacity,
  mouseInteraction,
  mouseStrength,
  mouseRadius,
  mouseDampening,
  lens,
  holdToWarp,
  intro,
  fade,
  lightMode,
  mixBlendMode,
  paused,
  dpr,
  dark,
  light,
};

const styleAttr = [mixBlendMode ? `mix-blend-mode: ${mixBlendMode}` : '', style ?? '']
  .filter(Boolean)
  .join('; ');
---

<div
  class:list={['lightfall-container', className]}
  style={styleAttr || undefined}
  data-lightfall={JSON.stringify(config)}
  aria-hidden="true"
>
  <canvas class="lightfall-canvas"></canvas>
</div>

<script>
  import { initLightfall } from '../scripts/lightfall';
  initLightfall();
</script>
